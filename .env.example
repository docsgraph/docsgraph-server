# Copy this file to .env and adjust values for your environment.
# These defaults match the services defined in docker-compose.yml.

# --- Application ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://docsgraph:docsgraph@localhost:5432/docsgraph

# --- Background jobs (Redis / arq) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (JWT) ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
